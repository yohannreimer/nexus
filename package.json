{
  "name": "adreport-ai---autotraffic-saas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\" --names \"VITE,SERVER\" --prefix-colors \"cyan,magenta\"",
    "build": "vite build",
    "build:server": "rm -rf dist-server && tsc server.ts --outDir dist-server --module commonjs --target es2020 --esModuleInterop --resolveJsonModule && printf '{\"type\":\"commonjs\"}\\n' > dist-server/package.json",
    "preview": "vite preview",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "db:migrate": "node scripts/run-postgres-migrations.mjs",
    "start": "node dist-server/server.js"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.49.0",
    "@google/genai": "^1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.84.0",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "html2pdf.js": "^0.12.1",
    "lucide-react": "^0.554.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.0",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.6",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
