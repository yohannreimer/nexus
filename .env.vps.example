# Copy this file to .env on the VPS and fill real values before running docker compose.

APP_PORT=3001
POSTGRES_DB=nexus_ai
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace_with_strong_password

VITE_APP_URL=https://nexus.yourdomain.com
VITE_NEXUS_API_URL=https://nexus.yourdomain.com
NEXUS_API_URL=https://nexus.yourdomain.com

VITE_CLERK_PUBLISHABLE_KEY=replace_with_clerk_publishable_key
VITE_PRYMEIRA_ACCOUNT_API_URL=https://account.yourdomain.com
VITE_PRYMEIRA_HUB_URL=https://app.prymeiradigital.com.br
VITE_PRYMEIRA_PRODUCT_KEY=ads
VITE_PRYMEIRA_AUTH_ENABLED=true
PRYMEIRA_ACCOUNT_API_URL=https://account.yourdomain.com
PRYMEIRA_PRODUCT_KEY=ads

NEXUS_OAUTH_STATE_SECRET=replace_with_random_32_byte_secret

VITE_FACEBOOK_APP_ID=replace_with_facebook_app_id
VITE_FACEBOOK_REDIRECT_URI=https://nexus.yourdomain.com/api/auth-callback
FACEBOOK_APP_ID=replace_with_facebook_app_id
FACEBOOK_APP_SECRET=replace_with_facebook_app_secret
FACEBOOK_GRAPH_VERSION=v23.0

GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=replace_with_google_ads_developer_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v24

VITE_N8N_WEBHOOK_URL=https://webhooks.yrdnegocios.com.br/webhook/nexusrelatorios

# Legacy Supabase values can stay empty if the Prymeira path is fully enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
