# This file is an example. Create a .env file in the root of the project and add your own values.
# IMPORTANT: The FACEBOOK_APP_SECRET should NOT be prefixed with VITE_.
# This is a security measure to prevent it from being exposed to the client-side code.

# --- Client-Side (Vite) Environment Variables ---
# Your Facebook App ID
VITE_FACEBOOK_APP_ID="YOUR_FACEBOOK_APP_ID"
# The full URL to your deployed serverless function (e.g., https://your-app.vercel.app/api/auth-callback)
VITE_FACEBOOK_REDIRECT_URI="http://localhost:5173/api/auth-callback"
# The base URL of your frontend application
VITE_APP_URL="http://localhost:5173"

# --- Prymeira Account Auth ---
VITE_CLERK_PUBLISHABLE_KEY="replace_with_clerk_publishable_key"
VITE_PRYMEIRA_ACCOUNT_API_URL="http://localhost:3001"
VITE_PRYMEIRA_HUB_URL="http://localhost:5175"
VITE_PRYMEIRA_PRODUCT_KEY="ads"
VITE_PRYMEIRA_AUTH_ENABLED="true"
VITE_NEXUS_API_URL="http://localhost:3001"
NEXUS_API_URL="http://localhost:3001"
NEXUS_OAUTH_STATE_SECRET="replace_with_random_32_byte_secret"

# --- Nexus Postgres ---
# Server-side only. Do not prefix with VITE_.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus_ai"

# --- Legacy Supabase integration ---
# These remain during migration for existing Edge Functions and data reads.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# --- n8n Webhook (for WhatsApp sending) ---
VITE_N8N_WEBHOOK_URL="https://webhooks.yrdnegocios.com.br/webhook/nexusrelatorios"

# --- Server-Side (Serverless Function) Environment Variables ---
# Your Facebook App Secret. DO NOT expose this to the frontend.
FACEBOOK_APP_SECRET="YOUR_FACEBOOK_APP_SECRET"

# --- Google Ads Edge Function Secrets ---
# Configure these in Supabase Edge Function secrets, not in the browser bundle.
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_ADS_DEVELOPER_TOKEN="your-google-ads-developer-token"
GOOGLE_ADS_LOGIN_CUSTOMER_ID="your-manager-customer-id-without-dashes"
GOOGLE_ADS_API_VERSION="v24"
